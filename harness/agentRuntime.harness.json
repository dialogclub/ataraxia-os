{
  "fn": "agentRuntime",
  "type": "llm-agent",
  "layer": "L2",
  "owner_agent": "Budget",
  "contract": { "input": "schemas/agents/*.out.json + tool_use/tool_result Messages API", "output": "AgentResult (core/agents/agentRunner.mjs)" },
  "determinism": { "runs": 2, "compare": "bytes" },
  "edge_cases": ["react-limit", "invalid-submit", "text-instead-of-submit", "overclaimed-badge", "bad-measure-path", "unknown-tool", "append-only-history", "429", "529-fallback", "refusal", "auth-circuit-breaker", "network", "timeout", "bad-request", "truncated", "pii"],
  "stress": { "n": 1, "assert": ["noNaN", "inRange"] },
  "golden": [{ "id": "requestor-demo", "input": "fixtures/agents/golden.mjs", "expect": "status ok" }],
  "eval": { "judge": true, "rubric": ["citation_accuracy", "anchoring", "completeness", "language", "badge_honesty", "number_honesty"] },
  "guardrails": { "retry_on_invalid": 2, "react_max_rounds": 3, "timeout_ms": 90000, "no_sampling_params": true, "badge_assigned_by_runtime": true, "numbers_only_from_tools": true },
  "telemetry": ["calls", "rounds", "submit_attempts", "usage", "model", "fallback"],
  "ui_contract": { "component": "DynamicIsland", "badge_policy": "⛔ при отказе API; отчёт L1 сохраняется" },
  "tools_required": [],
  "schema_strict": true,
  "retry_on_invalid": 2,
  "evidence_required": true,
  "self_consistency_k": 1,
  "golden_transcripts": ["demo (синтетический)"],
  "rubric": ["citation_accuracy", "anchoring", "completeness", "language", "badge_honesty", "number_honesty"],
  "model_regression": false,
  "model_regression_note": "требует живого ключа API; контракты рантайма и транспорта проверены двойником модели и заглушкой fetch",
  "status": "green",
  "version": "1.0.0"
}
