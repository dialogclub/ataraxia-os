{
  "fn": "scaleScorer",
  "type": "deterministic",
  "layer": "L1",
  "owner_agent": "ICD11Contour",
  "contract": { "input": "schemas/scale.in.json", "output": "schemas/scale.out.json" },
  "determinism": { "runs": 2, "compare": "bytes" },
  "edge_cases": ["unknown-scale", "incomplete", "out-of-range", "proprietary", "ranking-invalid"],
  "stress": { "n": 1000, "assert": ["noNaN", "inRange", "time<5ms"] },
  "golden": [
    { "id": "phq9-zeros", "expect": { "total": [0, 0] } }, { "id": "phq9-max", "expect": { "total": [27, 27] } },
    { "id": "gad7-band10", "expect": { "band": "умеренная" } }, { "id": "tas20-all3", "expect": { "total": [60, 60] } },
    { "id": "mbi-ee", "expect": { "EE": [27, 27] } }, { "id": "scl90-gsi", "expect": { "GSI": [4, 4] } }, { "id": "ipip-mid", "expect": { "E%": [50, 50] } }
  ],
  "eval": { "judge": false, "rubric": null },
  "guardrails": { "incomplete": "badge:⛔ без импутации", "proprietary": "badge:⛔ с причиной", "phq9_item9": "флаг кризиса" },
  "telemetry": ["scale", "n_items"],
  "ui_contract": { "component": "TrafficScale7", "badge_policy": "🟢" },
  "status": "green",
  "version": "1.0.0"
}
