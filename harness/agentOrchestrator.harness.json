{
  "fn": "agentOrchestrator",
  "type": "llm-agent",
  "layer": "L3",
  "owner_agent": "Router",
  "contract": { "input": "agents.registry.json + models.registry.json + prompts.registry.json", "output": "Map<agent, AgentResult> + synthesis" },
  "determinism": { "runs": 2, "compare": "bytes" },
  "edge_cases": ["dag-order", "partial-failure", "upstream-skipped", "no-api", "single-agent-retry", "k3-consensus", "scp-scope", "judge-hidden", "model-chain"],
  "stress": { "n": 1, "assert": ["noNaN", "inRange"] },
  "golden": [{ "id": "full-session", "input": "core/demo.mjs", "expect": "13/13 ok" }],
  "eval": { "judge": true, "rubric": ["citation_accuracy", "anchoring", "completeness", "language", "badge_honesty", "number_honesty"] },
  "guardrails": { "channel_missing": "badge:⛔", "l1_never_waits_model": true, "circuit_breaker": ["auth", "network"], "write_scope": "card.writes" },
  "telemetry": ["calls", "usage", "model", "fallback"],
  "ui_contract": { "component": "ResultCard", "badge_policy": "🟢/🟡/🔵/⛔" },
  "tools_required": [],
  "schema_strict": true,
  "retry_on_invalid": 2,
  "evidence_required": true,
  "self_consistency_k": 3,
  "golden_transcripts": ["demo (синтетический)"],
  "rubric": ["citation_accuracy", "anchoring", "completeness", "language", "badge_honesty", "number_honesty"],
  "model_regression": false,
  "model_regression_note": "требует живого ключа API",
  "status": "green",
  "version": "1.0.0"
}
