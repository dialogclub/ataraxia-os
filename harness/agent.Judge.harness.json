{
  "fn": "agent.Judge",
  "type": "deterministic",
  "layer": "L3",
  "owner_agent": "Judge",
  "contract": {
    "input": "AgentResult",
    "output": "рубрика 6 пунктов (Param 🟢)"
  },
  "determinism": {
    "runs": 2,
    "compare": "bytes"
  },
  "edge_cases": [
    "failed",
    "skipped",
    "no-claims",
    "overclaimed",
    "fabricated"
  ],
  "stress": {
    "n": 1000,
    "assert": [
      "noNaN",
      "inRange",
      "time<5ms"
    ]
  },
  "golden": [
    {
      "id": "golden-requestor",
      "expect": {
        "overall": [
          0.99,
          1
        ]
      }
    }
  ],
  "eval": {
    "judge": false,
    "rubric": null
  },
  "guardrails": {
    "hidden_from_client": true,
    "deterministic": true
  },
  "telemetry": [
    "duration"
  ],
  "ui_contract": {
    "component": "HarnessStatus",
    "badge_policy": "🟢"
  },
  "status": "green",
  "version": "1.0.0"
}
