{
  "fn": "lexisTool",
  "type": "deterministic",
  "layer": "L1",
  "owner_agent": "Veritas",
  "contract": { "input": "schemas/lexis.in.json", "output": "schemas/lexis.out.json" },
  "determinism": { "runs": 2, "compare": "bytes" },
  "edge_cases": ["empty", "no-speakers", "mixed-ru-ua", "en", "no-timestamps", "punctuation-only"],
  "stress": { "n": 1000, "assert": ["noNaN", "inRange", "time<20ms"] },
  "golden": [{ "id": "lexis-golden-v1", "input": "fixtures/lexis.golden.json", "expect": { "i": [80, 80], "they": [20, 20], "must_per_1000": [71, 72] } }],
  "eval": { "judge": false, "rubric": null },
  "guardrails": { "channel_missing": "badge:⛔", "proxies_badge": "🔵" },
  "telemetry": ["words_total", "turns_total", "duration"],
  "ui_contract": { "component": "Heatmap24", "badge_policy": "🟢 счётчики · 🔵 прокси" },
  "status": "green",
  "version": "1.0.0"
}
