{
  "$id": "atmaraksi.agents.Veritas.out",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "claims",
    "fields",
    "limits"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "claims": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,24}$"
          },
          "text": {
            "type": "string",
            "minLength": 3,
            "maxLength": 400
          },
          "evidence": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "quote",
                    "measure",
                    "claim"
                  ]
                },
                "quote": {
                  "type": "string",
                  "maxLength": 300
                },
                "speaker": {
                  "type": "string",
                  "maxLength": 24
                },
                "t": {
                  "type": "string",
                  "maxLength": 12
                },
                "tool": {
                  "type": "string",
                  "maxLength": 40
                },
                "path": {
                  "type": "string",
                  "maxLength": 80
                },
                "ref": {
                  "type": "string",
                  "maxLength": 60
                }
              }
            }
          },
          "claimed_badge": {
            "enum": [
              "🟢",
              "🟡",
              "🔵",
              "⛔"
            ]
          }
        }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "veracity_level",
        "displacements"
      ],
      "properties": {
        "veracity_level": {
          "enum": [
            "низкая",
            "средняя",
            "высокая",
            "не определить"
          ]
        },
        "displacements": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quote",
              "speaker",
              "t",
              "away_from"
            ],
            "properties": {
              "quote": {
                "type": "string",
                "maxLength": 300
              },
              "speaker": {
                "type": "string",
                "maxLength": 24
              },
              "t": {
                "type": "string",
                "maxLength": 12
              },
              "away_from": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    }
  }
}
