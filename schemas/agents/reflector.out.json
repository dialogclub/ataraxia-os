{
  "$id": "atmaraksi.agents.Reflector.out",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdicts",
    "axes",
    "contradictions",
    "limits"
  ],
  "properties": {
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "claim_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,24}$"
          },
          "text": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320
          },
          "claim_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "maxLength": 60
            }
          }
        }
      }
    },
    "axes": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "axis",
          "text",
          "claim_refs"
        ],
        "properties": {
          "axis": {
            "enum": [
              "сознание",
              "тело",
              "социальное поле",
              "нарратив"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320
          },
          "claim_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "maxLength": 60
            }
          }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "a",
          "b",
          "note"
        ],
        "properties": {
          "a": {
            "type": "string",
            "maxLength": 60
          },
          "b": {
            "type": "string",
            "maxLength": 60
          },
          "note": {
            "type": "string",
            "maxLength": 240
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    }
  }
}
